[Unit]
Description=Guardias IES Alcalans
After=network.target

[Service]
Type=simple
User=rafa
Group=rafa
WorkingDirectory=/srv/guardias/current
EnvironmentFile=/etc/guardias/guardias.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server/app.js
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/guardias /var/backups/guardias

[Install]
WantedBy=multi-user.target
