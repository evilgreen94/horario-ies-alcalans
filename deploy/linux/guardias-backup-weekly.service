[Unit]
Description=Backup semanal de Guardias IES Alcalans

[Service]
Type=oneshot
User=rafa
Group=rafa
UMask=0077
WorkingDirectory=/srv/guardias/current
Environment=GUARDIAS_DB_PATH=/var/lib/guardias/guardias.sqlite
Environment=BACKUP_ROOT=/var/backups/guardias
ExecStart=/usr/bin/env bash /srv/guardias/current/deploy/linux/backup-guardias.sh weekly
