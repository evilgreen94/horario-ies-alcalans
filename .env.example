# Server
PORT=3000
# The application binds to 127.0.0.1 in code. Nginx is the only LAN listener.
NODE_ENV=production

# Required
GUARDIAS_SESSION_SECRET=replace-with-a-long-random-secret

# Exactly one trusted reverse proxy (the local Nginx hop). Leave empty when
# running Node directly without Nginx.
GUARDIAS_TRUST_PROXY=1

# Database path
# Windows example:
# GUARDIAS_DB_PATH=C:\ruta\segura\guardias.sqlite
# Linux production path (outside immutable releases):
GUARDIAS_DB_PATH=/var/lib/guardias/guardias.sqlite

# Leave empty if frontend and backend are served from the same origin
# Example:
# GUARDIAS_CORS_ORIGINS=https://guardias.centro.es,https://intranet.centro.es
GUARDIAS_CORS_ORIGINS=

# Only needed when the target database does not already contain these legacy
# credentials. Remove them from the environment after the first successful seed.
GUARDIAS_ADMIN_PASSWORD=replace-with-initial-admin-password
GUARDIAS_SUPERADMIN_PASSWORD=replace-with-initial-superadmin-password

# Used by deployment/PM2 tooling; the default is shown here for documentation.
GUARDIAS_ENV_FILE=/etc/guardias/guardias.env
